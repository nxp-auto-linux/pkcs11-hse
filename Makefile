
include common.mk
include config.mk

CFLAGS += -fPIC
LDFLAGS ?=

PKCS_LIB ?= libpkcs-hse.so
PKCS_LIBVER_MAJOR = 1
PKCS_LIBVER_MINOR = 0
PKCS_LIBVER = $(PKCS_LIBVER_MAJOR).$(PKCS_LIBVER_MINOR)
PKCS_SDIR = libpkcs
PKCS_ODIR = $(PKCS_SDIR)/obj
PKCS_SRCS = $(wildcard $(PKCS_SDIR)/*.c)
PKCS_OBJS = $(patsubst $(PKCS_SDIR)/%.c,$(PKCS_ODIR)/%.o,$(PKCS_SRCS))

HSE_LIB ?= libhse.so
HSE_LIBVER_MAJOR = 2
HSE_LIBVER_MINOR = 1
HSE_LIBVER = $(HSE_LIBVER_MAJOR).$(HSE_LIBVER_MINOR)
HSE_SDIR = libhse
HSE_HEADER = libhse.h
HSE_ODIR = $(HSE_SDIR)/obj
HSE_SRCS = $(wildcard $(HSE_SDIR)/*.c)
HSE_OBJS = $(patsubst $(HSE_SDIR)/%.c,$(HSE_ODIR)/%.o,$(HSE_SRCS))

DEFS := -DUIO_DEV=$(UIO_DEV) -DHSE_LIBVER_MAJOR=$(HSE_LIBVER_MAJOR)

# PKCS configuration directory
PKCS_DIR ?= /etc
DEFS += -DPKCS_DIR=\"$(PKCS_DIR)\"

# Key store configuration

# Base key for PIN derivation
KS_BASE_KEY := -DBASE_KEY_CATALOG_ID=$(BASE_KEY_CATALOG_ID) \
               -DBASE_KEY_GROUP_ID=$(BASE_KEY_GROUP_ID) \
               -DBASE_KEY_SLOT_ID=$(BASE_KEY_SLOT_ID)

# Catalog IDs (which HSE catalog each group belongs to)
KS_CATALOG_IDS := -DAES_TOKEN_CATALOG_ID=$(AES_TOKEN_CATALOG_ID) \
                  -DHMAC_TOKEN_CATALOG_ID=$(HMAC_TOKEN_CATALOG_ID) \
                  -DECC_PAIR_TOKEN_CATALOG_ID=$(ECC_PAIR_TOKEN_CATALOG_ID) \
                  -DECC_PUB_TOKEN_CATALOG_ID=$(ECC_PUB_TOKEN_CATALOG_ID) \
                  -DRSA_PAIR_TOKEN_CATALOG_ID=$(RSA_PAIR_TOKEN_CATALOG_ID) \
                  -DRSA_PUB_TOKEN_CATALOG_ID=$(RSA_PUB_TOKEN_CATALOG_ID) \
                  -DAES_SESSION_CATALOG_ID=$(AES_SESSION_CATALOG_ID) \
                  -DHMAC_SESSION_CATALOG_ID=$(HMAC_SESSION_CATALOG_ID) \
                  -DSHARED_SECRET_SESSION_CATALOG_ID=$(SHARED_SECRET_SESSION_CATALOG_ID) \
                  -DECC_PUB_SESSION_CATALOG_ID=$(ECC_PUB_SESSION_CATALOG_ID) \
                  -DRSA_PUB_SESSION_CATALOG_ID=$(RSA_PUB_SESSION_CATALOG_ID) \
                  -DECC_PAIR_SESSION_CATALOG_ID=$(ECC_PAIR_SESSION_CATALOG_ID) \
                  -DRSA_PAIR_SESSION_CATALOG_ID=$(RSA_PAIR_SESSION_CATALOG_ID)

# Group IDs (HSE catalog group numbers)
KS_GROUP_IDS := -DAES_TOKEN_GROUP_ID=$(AES_TOKEN_GROUP_ID) \
                -DHMAC_TOKEN_GROUP_ID=$(HMAC_TOKEN_GROUP_ID) \
                -DECC_PAIR_TOKEN_GROUP_ID=$(ECC_PAIR_TOKEN_GROUP_ID) \
                -DECC_PUB_TOKEN_GROUP_ID=$(ECC_PUB_TOKEN_GROUP_ID) \
                -DRSA_PAIR_TOKEN_GROUP_ID=$(RSA_PAIR_TOKEN_GROUP_ID) \
                -DRSA_PUB_TOKEN_GROUP_ID=$(RSA_PUB_TOKEN_GROUP_ID) \
                -DAES_SESSION_GROUP_ID=$(AES_SESSION_GROUP_ID) \
                -DHMAC_SESSION_GROUP_ID=$(HMAC_SESSION_GROUP_ID) \
                -DSHARED_SECRET_SESSION_GROUP_ID=$(SHARED_SECRET_SESSION_GROUP_ID) \
                -DECC_PUB_SESSION_GROUP_ID=$(ECC_PUB_SESSION_GROUP_ID) \
                -DRSA_PUB_SESSION_GROUP_ID=$(RSA_PUB_SESSION_GROUP_ID) \
                -DECC_PAIR_SESSION_GROUP_ID=$(ECC_PAIR_SESSION_GROUP_ID) \
                -DRSA_PAIR_SESSION_GROUP_ID=$(RSA_PAIR_SESSION_GROUP_ID)

# Group sizes (number of slots per group)
KS_GROUP_SIZES := -DAES_TOKEN_GROUP_SIZE=$(AES_TOKEN_GROUP_SIZE) \
                  -DHMAC_TOKEN_GROUP_SIZE=$(HMAC_TOKEN_GROUP_SIZE) \
                  -DECC_PAIR_TOKEN_GROUP_SIZE=$(ECC_PAIR_TOKEN_GROUP_SIZE) \
                  -DECC_PUB_TOKEN_GROUP_SIZE=$(ECC_PUB_TOKEN_GROUP_SIZE) \
                  -DRSA_PAIR_TOKEN_GROUP_SIZE=$(RSA_PAIR_TOKEN_GROUP_SIZE) \
                  -DRSA_PUB_TOKEN_GROUP_SIZE=$(RSA_PUB_TOKEN_GROUP_SIZE) \
                  -DAES_SESSION_GROUP_SIZE=$(AES_SESSION_GROUP_SIZE) \
                  -DHMAC_SESSION_GROUP_SIZE=$(HMAC_SESSION_GROUP_SIZE) \
                  -DSHARED_SECRET_SESSION_GROUP_SIZE=$(SHARED_SECRET_SESSION_GROUP_SIZE) \
                  -DECC_PUB_SESSION_GROUP_SIZE=$(ECC_PUB_SESSION_GROUP_SIZE) \
                  -DRSA_PUB_SESSION_GROUP_SIZE=$(RSA_PUB_SESSION_GROUP_SIZE) \
                  -DECC_PAIR_SESSION_GROUP_SIZE=$(ECC_PAIR_SESSION_GROUP_SIZE) \
                  -DRSA_PAIR_SESSION_GROUP_SIZE=$(RSA_PAIR_SESSION_GROUP_SIZE)

CFLAGS += $(KS_BASE_KEY) $(KS_CATALOG_IDS) $(KS_GROUP_IDS) $(KS_GROUP_SIZES)

# Firmware version-major extraction logic
ifneq ($(MAKECMDGOALS),clean)
	HSE_FW_VERSION_MAJOR ?= $(shell \
		$(HOSTCC) $(INCLUDE_LIBHSE) -o $(FW_PARSER_BIN) $(FW_PARSER_SRC) && \
		$(FW_PARSER_BIN) --fw-version-major && rm -f $(FW_PARSER_BIN) || echo 0)

	ifeq ($(HSE_FW_VERSION_MAJOR),0)
		$(error "Invalid firmware version major")
	endif

	DEFS += -DHSE_FW_VERSION_MAJOR=$(HSE_FW_VERSION_MAJOR)
endif

all: $(PKCS_LIB).$(PKCS_LIBVER) examples

$(PKCS_LIB).$(PKCS_LIBVER): $(HSE_LIB).$(HSE_LIBVER) $(PKCS_OBJS)
	$(CC) -shared $(CFLAGS) -L$(shell pwd) -Wl,-soname,$(PKCS_LIB).$(PKCS_LIBVER_MAJOR) \
	$(LDFLAGS) $(PKCS_OBJS) -o $@ -lhse

$(PKCS_ODIR)/%.o: $(PKCS_SDIR)/%.c $(PKCS_ODIR)
	$(CC) -c $(CFLAGS) $(DEFS) $(INCLUDE_LIBPKCS) $(INCLUDE_LIBHSE) $(LDFLAGS) $< -o $@

$(PKCS_ODIR):
	mkdir -p $@

$(HSE_LIB).$(HSE_LIBVER): $(HSE_OBJS)
	$(CC) -shared $(CFLAGS) -Wl,-soname,$(HSE_LIB).$(HSE_LIBVER_MAJOR) $(LDFLAGS) $(HSE_OBJS) -o $@ -lpthread
	ln -sf $@ $(HSE_LIB)

$(HSE_ODIR)/%.o: $(HSE_SDIR)/%.c $(HSE_ODIR)
	$(CC) -c $(CFLAGS) $(INCLUDE_LIBHSE) $(DEFS) $(LDFLAGS) $< -o $@

$(HSE_ODIR):
	mkdir -p $@

.PHONY: examples
examples: $(HSE_LIB).$(HSE_LIBVER)
	make -C examples PKCS11HSE_DIR=$(CURDIR)

clean:
	rm -f *.so*
	rm -rf $(PKCS_ODIR) $(HSE_ODIR)
	make -C examples clean

install: $(PKCS_LIB).$(PKCS_LIBVER) examples
	@mkdir -p $(INSTALL_INCLUDEDIR)
	@mkdir -p $(INSTALL_LIBDIR)
	@mkdir -p $(INSTALL_BINDIR)

	@echo "Installing pkcs11 libraries in $(INSTALL_LIBDIR)"
	@install $(PKCS_LIB).$(PKCS_LIBVER) $(INSTALL_LIBDIR)
	@ln -sf $(PKCS_LIB).$(PKCS_LIBVER) $(INSTALL_LIBDIR)/$(PKCS_LIB).$(PKCS_LIBVER_MAJOR)

	@install $(HSE_LIB).$(HSE_LIBVER) $(INSTALL_LIBDIR)
	@ln -sf $(HSE_LIB).$(HSE_LIBVER) $(INSTALL_LIBDIR)/$(HSE_LIB).$(HSE_LIBVER_MAJOR)
	@ln -sf $(HSE_LIB).$(HSE_LIBVER) $(INSTALL_LIBDIR)/$(HSE_LIB)

	@install $(HSE_SDIR)/$(HSE_HEADER) $(INSTALL_INCLUDEDIR)

	@echo "Installing example binaries in $(INSTALL_BINDIR)"
	make -C examples install EXAMPLES_INSTALLDIR=$(INSTALL_BINDIR)

.PHONY: clean all install
